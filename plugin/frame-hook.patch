+
+// Resolve Source2Client002 through the client module's own CreateInterface export, which only reads its load-time
+// interface registry, instead of the app-system factory that is still being populated by the engine thread.
+ISource2Client* FindClientInterface()
+{
+#ifdef _WIN32
+    HMODULE clientModule = GetModuleHandle("client.dll");
+#else
+    string clientPath = string(Plat_GetGameDirectory()) + "/csgo/bin/linuxsteamrt64/libclient.so";
+    void* clientModule = dlopen(clientPath.c_str(), RTLD_NOW | RTLD_NOLOAD);
+#endif
+    if (clientModule == NULL) {
+        return NULL;
+    }
+
+    auto clientCreateInterface = (CreateInterfaceFn)GetLibAddress(clientModule, "CreateInterface");
+    ISource2Client* result = NULL;
+    if (clientCreateInterface != NULL) {
+        result = (ISource2Client*)clientCreateInterface("Source2Client002", NULL);
+    }
+#ifndef _WIN32
+    dlclose(clientModule); // drops the reference taken by RTLD_NOLOAD
+#endif
+    return result;
+}
+
+// Since the 19/08/2026 CS2 update, ClientFullyConnect is no longer called during demo playback and Source2Client002
+// is not available yet when Connect runs, so wait for the client module in the background.
+void WaitForClientInterface()
+{
+    const int timeoutMs = 180000;
+    for (int waited = 0; waited < timeoutMs && !isQuitting; waited += 50) {
+        if (client != NULL || InstallFrameHook(FindClientInterface())) {
+            return;
+        }
+        std::this_thread::sleep_for(std::chrono::milliseconds(50));
+    }
+    if (client == NULL && !isQuitting) {
+        Log("Source2Client002 not found after %d ms, tick actions will not run", timeoutMs);
+    }
+}
